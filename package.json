{
  "name": "taskflow",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:web dev:swa",
    "dev:web": "pnpm --filter @taskflow/web dev",
    "dev:swa": "swa start",
    "build": "pnpm --filter @taskflow/web build && pnpm --filter @taskflow/api build",
    "deploy": "node scripts/deploy.mjs",
    "test:unit": "pnpm --filter @taskflow/web test:unit",
    "test:e2e": "pnpm --filter @taskflow/web test:e2e",
    "lint": "pnpm --filter @taskflow/web lint",
    "storybook": "pnpm --filter @taskflow/web storybook"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
